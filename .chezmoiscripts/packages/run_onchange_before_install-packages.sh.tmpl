#!/bin/bash
set -eufo pipefail

{{ if eq .chezmoi.osRelease.id "debian" -}}
sudo apt-get update
sudo apt-get install -y {{ .packages.apt | join " " }}
{{ else if eq .chezmoi.osRelease.id "fedora" -}}
sudo dnf install -y {{ .packages.dnf | join " " }}
{{ else if or (eq .chezmoi.osRelease.id "arch") (eq .chezmoi.osRelease.id "endeavouros") -}}
sudo pacman -Syu --noconfirm {{ .packages.pacman | join " " }}
{{ else -}}
echo "Unsupported distro: {{ .chezmoi.osRelease.id }}" >&2
exit 1
{{ end -}}